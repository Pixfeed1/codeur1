# Copier ce fichier en `.env` et adapter. Toutes les variables sont optionnelles.

# Domaine public (utilisé pour générer les URL des cartes dans le CSV)
BASE_URL=https://votre-domaine.fr

# Port d'écoute de l'application Node
PORT=3000

# Mettre 1 dès que l'app tourne derrière un reverse proxy (Nginx, Caddy, Traefik…)
# pour que l'anti-bruteforce voie la vraie IP des visiteurs.
TRUST_PROXY=1

# Dossier des données (base SQLite + audios + exports). Par défaut : ./data
# Le déplacer hors du dépôt si vous préférez, ex. /srv/ravive-data
#DATA_DIR=/srv/ravive-data

# Secret de signature (jetons + empreintes des codes).
# Auto-généré dans data/.secret au premier lancement si absent.
# NE PLUS LE CHANGER une fois des cartes imprimées, et LE CONSERVER
# lors d'une migration de serveur (il fait partie du dossier data/).
#SECRET=

# Identifiant + mot de passe de la page d'administration /admin
# (les deux sont requis ; sans eux, l'admin est entièrement désactivée)
#ADMIN_USER=
#ADMIN_TOKEN=

# Limites d'enregistrement
#MAX_DURATION_S=180
#MAX_UPLOAD_BYTES=26214400
